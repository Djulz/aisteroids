{
  "name": "aisteroid-mining",
  "version": "0.27.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "balance": "node --experimental-strip-types scripts/pass-p-campaign.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "preview": "vite preview --host 0.0.0.0",
    "explore": "node --experimental-strip-types scripts/pass-o-frontier-trial.ts",
    "frontier": "node --experimental-strip-types scripts/pass-o-frontier-trial.ts",
    "biomes": "node --experimental-strip-types --test --test-name-pattern='five coherent layers' tests/pass-o.test.ts",
    "progression": "node --experimental-strip-types scripts/pass-p-campaign.ts",
    "performance": "node --experimental-strip-types scripts/performance.ts",
    "dispatch": "node --experimental-strip-types scripts/late-game-dispatch.ts",
    "campaign:o": "node --experimental-strip-types scripts/pass-o-campaign.ts",
    "frontier:o": "node --experimental-strip-types scripts/pass-o-frontier-trial.ts",
    "campaign:p": "node --experimental-strip-types scripts/pass-p-campaign.ts",
    "compare:p": "node --experimental-strip-types scripts/pass-p-comparison.ts",
    "legacy:balance": "node --experimental-strip-types scripts/pass-d-balance.ts",
    "legacy:explore": "node --experimental-strip-types scripts/pass-e-benchmark.ts",
    "legacy:frontier": "node --experimental-strip-types scripts/pass-f-frontier.ts",
    "legacy:biomes": "node --experimental-strip-types scripts/pass-i-biomes.ts",
    "legacy:progression": "node --experimental-strip-types scripts/pass-k-progression.ts"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.2.8",
    "@fontsource/barlow-condensed": "^5.2.8"
  }
}
